{
	"name": "nyx-auth",
	"private": true,
	"scripts": {
		"prepare": "husky || echo ''",
		"dev": "turbo dev",
		"build": "turbo build",
		"typecheck": "turbo typecheck",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"tegami": "bun scripts/tegami.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"husky": "9.1.7",
		"lint-staged": "17.1.0",
		"tegami": "1.2.6",
		"turbo": "2.10.5"
	},
	"peerDependencies": {
		"typescript": "catalog:"
	},
	"workspaces": {
		"packages": [
			"shared/**",
			"packages/**",
			"examples/**"
		],
		"catalog": {
			"@types/bun": "1.3.13",
			"bunup": "0.16.32",
			"drizzle-orm": ">=0.36.0",
			"drizzle-kit": ">=0.28.0",
			"typescript": "^5"
		}
	},
	"packageManager": "bun@1.3.13",
	"lint-staged": {
		"*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
	}
}
