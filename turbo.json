{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"tasks": {
		"dev": {
			"cache": false,
			"persistent": true
		},
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["src/**/*.ts"],
			"outputs": ["dist/**"]
		},
		"typecheck": {
			"inputs": ["src/**/*.ts"]
		}
	},
	"globalDependencies": ["package.json", "bunfig.toml", "tsconfig*.json", "biome.json"],
	"globalEnv": ["NODE_ENV"]
}
